# Build with the repository root as context; only execution code and prompts enter the image.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm iptables util-linux ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code@2.1.222

WORKDIR /app
COPY pyproject.toml ./
RUN python -c 'import subprocess, tomllib; subprocess.run(["pip", "install", "--no-cache-dir", *tomllib.load(open("pyproject.toml", "rb"))["project"]["dependencies"]], check=True)'

COPY harness ./harness
COPY experiments ./experiments
COPY launcher ./launcher
COPY prompts ./prompts
ENV PYTHONPATH=/app
RUN python -c 'import json; from harness.session.constants import BASH_DENIALS, DISALLOWED_TOOLS, MANAGED_SETTINGS_FILE; MANAGED_SETTINGS_FILE.parent.mkdir(parents=True); MANAGED_SETTINGS_FILE.write_text(json.dumps({"permissions": {"deny": sorted(DISALLOWED_TOOLS | BASH_DENIALS)}}))'
ENV HARNESS_CLI_PATH=/usr/local/bin/claude
ENTRYPOINT ["python", "-m", "harness.sandbox.bootstrap"]
CMD []
