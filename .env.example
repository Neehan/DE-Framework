# Copy to .env at the repository root and fill in the providers you use.
# Existing exported variables take precedence. Model, experiment, seeds, and concurrency are CLI options.

# Optional Hugging Face dataset repository URL. Local datasets/*.jsonl are used first.
# Leave empty when aobench.jsonl and imoproofbench.jsonl are already in datasets/.
HF_DATASET_REPO_URL=

# Anthropic: configure exactly one credential family, including any exported variables.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_2=
# Alternatively, use ANTHROPIC_AUTH_TOKEN or CLAUDE_CODE_OAUTH_TOKEN instead of API keys.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_AUTH_TOKEN_2=
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN_2=
# Optional custom endpoint; omit to use the built-in Anthropic endpoint.
# ANTHROPIC_BASE_URL=https://your-anthropic-endpoint.example

# Meta Muse: optional numbered keys share one endpoint.
META_API_KEY=
# META_API_KEY_2=
# Optional custom endpoint; omit to use the built-in Meta endpoint.
# META_BASE_URL=https://your-meta-endpoint.example

# Local GPT / LiteLLM: set login-file paths and choose one private gateway key.
# Run bash scripts/setup.sh to import accounts, start gateways, and fill their URLs below.
# Each path must contain a different subscription's Codex auth.json. Paths may be
# absolute, start with ~, or be relative to the repository root. Quote paths containing spaces.
CODEX_AUTH_FILE_1=
# CODEX_AUTH_FILE_2=/absolute/path/to/second-account/auth.json
# Example for one existing login: CODEX_AUTH_FILE_1=~/.codex/auth.json
# This key protects your local gateways; it is not an OpenAI API key.
LITELLM_API_KEY=
# Setup maintains these endpoint values when local auth files are configured.
# LITELLM_BASE_URL_1=
# LITELLM_BASE_URL_2=

# For an existing LiteLLM service, leave CODEX_AUTH_FILE entries empty and use
# your service's endpoint and key instead. Setup will not manage that service.
# LITELLM_BASE_URL=https://your-litellm-endpoint.example
# LITELLM_API_KEY_2=
# Use multiple endpoints OR multiple keys, not both.

# Add further numeric suffixes (_3, _4, ...) to extend a credential pool.
